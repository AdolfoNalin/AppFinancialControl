<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:AppFinancialControl.Libraries.Converters"
             x:Class="AppFinancialControl.View.TransactionList"
             Title="Listagem "
             NavigationPage.HasNavigationBar="True">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:TransactionValueColorConvert x:Key="TransactionValueColorConvert"/>
            <converters:TransactionValueConverter x:Key="TransactionValueConverter"/>
            <converters:TransactionNameConverter x:Key="TransactionNameConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <NavigationPage.TitleView>
        <Button
            TextColor="White"
            FontSize="10"
            BackgroundColor="Transparent"
            Text="Perfil"
            ImageSource="perfil_usuario.png"/>

    </NavigationPage.TitleView>


    <Grid
        RowDefinitions="*, Auto">
        <ScrollView>

            <CollectionView
            x:Name="cvTransaction">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid 
                            Padding="15"
                            RowDefinitions="Auto"
                            ColumnDefinitions="50, *, Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer 
                                        CommandParameter="{Binding .}"
                                        Tapped="OpenScreenEdit">

                                </TapGestureRecognizer>
                            </Grid.GestureRecognizers>

                            <Border 
                                WidthRequest="40"
                                HeightRequest="40"
                                StrokeShape="RoundRectangle 20">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                    Tapped="Delete_Tapped"
                                    CommandParameter="{Binding .}">
                                    </TapGestureRecognizer>
                                </Border.GestureRecognizers>

                                <Label 
                                Text="{Binding Name, Converter={StaticResource TransactionNameConverter}}"
                                Margin="10"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                FontSize="15"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1">
                                <Label
                               Text="{Binding Name}"/>
                                <Label 
                                Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}"/>

                            </VerticalStackLayout>
                            <Label 
                            Text="{Binding ., Converter={StaticResource TransactionValueConverter}}"
                            TextColor="{Binding ., Converter={StaticResource TransactionValueColorConvert}}"
                            VerticalOptions="Center"
                            Grid.Column="2"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </ScrollView>

        <Border
            Margin="10"
            BackgroundColor="Black"
            Stroke="Transparent"
            Padding="15"
            Grid.Row="1"
            StrokeShape="30">

            <Grid 
                ColumnDefinitions="*,80"
                RowDefinitions="Auto,Auto,20, Auto, Auto">

                <Label
                    Text="Saldo"
                    TextColor="White"
                    FontSize="18"/>

                <Label 
                    x:Name="lblBalance"
                    TextColor="White"
                    Grid.Row="1"
                    FontSize="36"/>

                <Button
                    Text="+"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Clicked="OpenScreenAdd"
                    Grid.Column="1"
                    Grid.RowSpan="2"
                    Padding="0"
                    FontSize="25"
                    WidthRequest="20"
                    HeightRequest="40"/>

                <Label
                    TextColor="White"
                    Text="Receita"
                    Grid.Row="3"
                    FontSize="10"/>

                <Label 
                    x:Name="lblIncome"
                    TextColor="White"
                    Grid.Row="4"/>

                <Label
                    TextColor="White"
                    Text="Despesa"
                    Grid.Column="1"
                    Grid.Row="3"
                    FontSize="10"/>

                <Label 
                    TextColor="White"
                    x:Name="lblExpense"
                    Grid.Column="1"
                    Grid.Row="4"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>