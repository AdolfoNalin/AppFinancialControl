<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppFinancialControl.View.TransactionList"
             Title="Listagem "
             NavigationPage.HasNavigationBar="False">
    <VerticalStackLayout>

        <CollectionView
            x:Name="cvTransaction">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid 
                     Padding="15"
                     ColumnDefinitions="50, *, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer 
                                CommandParameter="{Binding .}"
                                Tapped="OpenScreenEdit">

                            </TapGestureRecognizer>
                        </Grid.GestureRecognizers>
                        <Label 
                         Text="S"
                         Margin="10"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         FontSize="15"/>

                        <VerticalStackLayout Grid.Column="1">
                            <Label
                               Text="{Binding Name}"/>
                            <Label 
                                Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}"/>

                        </VerticalStackLayout>
                        <Label 
                            Text="{Binding Value, StringFormat='{0:C}'}"
                            VerticalOptions="Center"
                            Grid.Column="2"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Border
            Margin="10"
            BackgroundColor="Black"
            Stroke="Transparent"
            Padding="15"
            StrokeShape="30">
            
            <Grid 
                ColumnDefinitions="*,80"
                RowDefinitions="Auto,Auto,20, Auto, Auto">

                <Label
                    Text="Saldo"
                    TextColor="#979797"
                    FontSize="18"/>

                <Label 
                    x:Name="lblBalance"
                    Grid.Row="1"
                    FontSize="36"/>

                <Button
                    Text="+"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Clicked="OpenScreenAdd"
                    Grid.Column="1"
                    Grid.RowSpan="2"
                    Padding="0"
                    FontSize="25"
                    WidthRequest="20"
                    HeightRequest="40"/>

                <Label
                    Text="Receita"
                    Grid.Row="3"
                    TextColor="#979797"
                    FontSize="10"/>

                <Label 
                    x:Name="lblIncome"
                    Grid.Row="4"/>

                <Label
                    Text="Despesa"
                    Grid.Column="1"
                    Grid.Row="3"
                    TextColor="#979797"
                    FontSize="10"/>

                <Label 
                    x:Name="lblExpense"
                    Grid.Column="1"
                    Grid.Row="4"/>
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentPage>