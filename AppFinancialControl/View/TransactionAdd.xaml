<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppFinancialControl.View.TransactionAdd"
             Title="TransactionAdd">
    <VerticalStackLayout 
        Spacing="10">

        <Border 
            BackgroundColor="Black"
            Stroke="Transparent"
            Margin="15"
            Padding="15"
            StrokeShape="RoundRectangle 25">

            <Grid 
                RowDefinitions="Auto"
                ColumnDefinitions="*, 30">

                <Label
                    Text="Novo"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Grid.Row="0"
                    Grid.Column="0"/>

                <Image
                    Source="close.png"
                    HorizontalOptions="Center"
                    Grid.Row="0"
                    Grid.Column="1"
                    WidthRequest="17">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer 
                            Tapped="TapGestureRecognizer_Tapped"/>
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </Border>

        <Grid 
            ColumnDefinitions="*,*"
             Margin="30,10">
            
            <RadioButton
                HorizontalOptions="Start"
                Grid.Row="0"
                Grid.Column="0"
                IsChecked="True"
                Content="Receita"
                FontSize="Caption"/>

            <RadioButton
                HorizontalOptions="End"
                Grid.Row="0"
                Grid.Column="2"
                IsChecked="False"
                Content="Despesa"
                FontSize="Caption"/>
        </Grid>

        <Entry 
            Placeholder="Nome"
            Margin="15.0"/>

        <DatePicker
            Margin="15.0"/>

        <Entry
            Margin="15.0"
            Placeholder="Valor"/>

        <Button
            Text="Salvar"
            Margin="15"
            HorizontalOptions="Center"
            BackgroundColor="GreenYellow"
            FontAttributes="Bold"
            />

    </VerticalStackLayout>
</ContentPage>